rules_version = '2';

// Vinum — règles Firestore.
//
// Modèle : chaque utilisateur ne peut lire et écrire QUE ses propres données :
//   users/{uid}            profil
//   users/{uid}/wine/{id}  fiches de vins de sa cave
//   users/{uid}/catalogue/{id}  ses fiches personnelles du catalogue
//   catalogue/{id}              vins publiés du catalogue commun (lecture seule)
//   catalogueProposals/{id}     propositions au catalogue commun (auteur, modération Admin)
// Tout le reste est refusé par défaut.
//
// Les validations de contenu sont volontairement tolérantes avec les anciens documents
// (champs facultatifs), mais bornent la taille et le type des champs critiques afin
// qu'un client modifié ne puisse pas stocker n'importe quoi. Voir docs/SECURITY.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Disposition de la cave : au plus 240 emplacements (CAVE_MAX_PREMIUM côté application).
    function validCaveConfig(config) {
      return config is map
        && config.rows is int && config.rows >= 0 && config.rows <= 240
        && config.cols is int && config.cols >= 0 && config.cols <= 240
        && config.rows * config.cols <= 240
        && config.viewMode in ['grid', 'list'];
    }

    function validUser(data) {
      return (!('firstName' in data) || isShortString(data.firstName, 100))
        && (!('lastName' in data) || isShortString(data.lastName, 100))
        && (!('email' in data) || isShortString(data.email, 320))
        && (!('caveConfig' in data) || validCaveConfig(data.caveConfig));
    }

    function validWineFields(data) {
      return isShortString(data.name, 200) && data.name.size() > 0
        && data.type in ['red', 'white', 'rose', 'champagne']
        && (!('domain' in data) || isShortString(data.domain, 200))
        && (!('region' in data) || isShortString(data.region, 200))
        && (!('appellation' in data) || isShortString(data.appellation, 200))
        && (!('grapeVariety' in data) || isShortString(data.grapeVariety, 200))
        && (!('description' in data) || isShortString(data.description, 5000))
        && (!('vintage' in data) || (data.vintage is number && data.vintage >= 0 && data.vintage <= 3000))
        && (!('peakMaturityYear' in data) || (data.peakMaturityYear is number && data.peakMaturityYear >= 0 && data.peakMaturityYear <= 3000))
        && (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000))
        && (!('addedAt' in data) || isShortString(data.addedAt, 40))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('foodPairing' in data) || (data.foodPairing is list && data.foodPairing.size() <= 50))
        && (!('placements' in data) || (data.placements is list && data.placements.size() <= 240));
    }

    function validWine(uid, data) {
      return validWineFields(data)
        && (!('ownerId' in data) || data.ownerId == uid);
    }

    function validCatalogueWine(data) {
      return data.keys().hasOnly([
          'name', 'domain', 'region', 'vintage', 'type', 'grapeVariety', 'unitPrice',
          'description', 'foodPairing', 'rating', 'peakMaturityYear'
        ])
        && validWineFields(data);
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      match /wine/{wineId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWine(uid, request.resource.data);
      }

      // Fiches personnelles du catalogue : mêmes champs et mêmes bornes qu'une fiche de cave.
      match /catalogue/{wineId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWine(uid, request.resource.data);
      }
    }

    // Les vins publiés sont administrés côté serveur.
    match /catalogue/{wineId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && validCatalogueWine(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin()
        && get(/databases/$(database)/documents/catalogueProposals/$(wineId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/catalogueProposals/$(wineId)).data.status == 'pending';
    }

    // Propositions : l'auteur les crée et les relit ; un administrateur peut les modérer.
    match /catalogueProposals/{proposalId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'name', 'domain', 'region', 'vintage', 'type', 'grapeVariety', 'unitPrice', 'description',
          'foodPairing', 'rating', 'peakMaturityYear', 'ownerId', 'status', 'createdAt'
        ])
        && validWine(request.auth.uid, request.resource.data);
      allow update: if isAdmin()
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.moderatedBy == request.auth.uid
            && request.resource.data.moderatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'moderatedBy', 'moderatedAt', 'rejectionReason',
              'name', 'domain', 'region', 'vintage', 'type', 'grapeVariety', 'unitPrice',
              'description', 'foodPairing', 'rating', 'peakMaturityYear'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'status', 'moderatedBy', 'moderatedAt'
            ])
            && (
              (request.resource.data.status == 'approved'
                && !('rejectionReason' in request.resource.data)
                && validWineFields(request.resource.data))
              || (request.resource.data.status == 'rejected'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'moderatedBy', 'moderatedAt', 'rejectionReason'
                ])
                && (!('rejectionReason' in request.resource.data)
                  || isShortString(request.resource.data.rejectionReason, 1000)))
            )
          )
          || (
            resource.data.status in ['approved', 'rejected']
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'moderatedBy', 'moderatedAt', 'rejectionReason'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status'])
            && !('moderatedBy' in request.resource.data)
            && !('moderatedAt' in request.resource.data)
            && !('rejectionReason' in request.resource.data)
            && (
              resource.data.status == 'rejected'
              || !existsAfter(/databases/$(database)/documents/catalogue/$(proposalId))
            )
          )
        )
        && request.resource.data.keys().hasOnly([
          'name', 'domain', 'region', 'vintage', 'type', 'grapeVariety', 'unitPrice',
          'description', 'foodPairing', 'rating', 'peakMaturityYear', 'ownerId', 'status',
          'createdAt', 'moderatedBy', 'moderatedAt', 'rejectionReason'
        ]);
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Par défaut : tout est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
